# Maintainer: ejfkdev (https://github.com/ejfkdev)
pkgname=ddc-bin
pkgver=0.1.33
pkgrel=1
pkgdesc='DEX to Java decompiler with a CLI, HTTP API and MCP server'
arch=(aarch64 x86_64)
url=https://github.com/ejfkdev/ddc
license=(MIT)
depends=(glibc gcc-libs)
provides=(ddc)
conflicts=(ddc)
options=('!strip' '!debug')
source=(LICENSE::https://raw.githubusercontent.com/ejfkdev/ddc/v0.1.33/LICENSE)
source_aarch64=("ddc-${pkgver}-aarch64::https://github.com/ejfkdev/ddc/releases/download/v0.1.33/ddc-v0.1.33-aarch64-unknown-linux-gnu")
source_x86_64=("ddc-${pkgver}-x86_64::https://github.com/ejfkdev/ddc/releases/download/v0.1.33/ddc-v0.1.33-x86_64-unknown-linux-gnu")
sha256sums=(2f55f4862e6e627670c2439847c70c6ab9bcffa5f39eac0fcc8ff11af80fc41e)
sha256sums_aarch64=(74b82c9ff0d812536129a5f92ac48ea77afb4c1be07fb09d1bab8a798911c1b0)
sha256sums_x86_64=(afc9434738fe2634898b62c71adb82849391a6bc43e9d19f7a4c88a51e3afa78)

package() {
  install -Dm755 "${srcdir}/ddc-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/ddc"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
